{
  "ruleset": "classic_revised",
  "title": "Vampire: The Masquerade Revised (oWoD) constants",
  "sources": {
    "primary": "VtM Revised core (2000); page numbers in 'ref' fields are printed Revised pages",
    "cross_check": "V20 core, used only where the Revised text extraction was unreadable (flagged with 'source': 'V20')",
