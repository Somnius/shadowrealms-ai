  "dice": {
    "die": "d10",
    "difficulty_min": 2,
    "difficulty_max": 10,
    "difficulty_default": 6,
    "ten_always_succeeds": true,
    "ones_cancel_successes": true,
    "botch_rule": "botch iff raw_successes == 0 and ones >= 1; successes cancelled to 0 by ones = plain failure",
    "max_traits_in_pool": 2,
    "trait_1_to_10_pool_cannot_add_other_traits": true,
    "willpower_auto_success": {
      "successes": 1,
      "max_per_turn": 1,
      "declare_before_roll": true,
      "cancellable_by_ones": false,
      "ref": "pp. 137, 193"
    },
    "specialty": {
      "min_trait_rating": 4,
      "revised_mode": "reroll_tens_open_ended",
      "v20_mode": "ten_counts_double",
      "default_mode": "revised_reroll",
      "ambiguous": "whether 1s on rerolled dice cancel successes (default: no)",
      "ref": "p. 117; V20 p. 96"
    },
    "automatic_success": {
      "condition": "pool >= difficulty",
      "successes": 1,
      "not_in_combat_or_stress": true,
      "ref": "p. 193"
    },
    "retry_penalty": "+1 difficulty per repeated failed attempt (ST option)",
    "multiple_actions": "first pool -N dice (N = number of actions), each later action -1 more cumulative; pool <= 0 => not allowed",
    "damage_and_soak_can_botch": false,
    "untrained": {
      "talents": "attribute only, no penalty",
      "skills": "attribute only, +1 difficulty",
      "knowledges": "no roll unless ST permits",
