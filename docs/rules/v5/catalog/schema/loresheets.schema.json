{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadowrealms/v5/catalog/loresheets.schema.json",
  "title": "V5 Loresheets",
  "description": "One entry per sheet: restriction as printed under the title, structured clans_only / clans_excluded / disciplines_only / thin_blood_only, and the five level names (dots 1-5, names only). A level may carry its own printed restriction (restriction + clans_only). A level name is null only on an entry whose facts come from an online source that does not give it (source online).",
  "type": "object",
  "required": [
    "catalog",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "const": "loresheets"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "book",
          "page",
          "restriction",
          "clans_only",
          "disciplines_only",
          "thin_blood_only",
          "levels",
          "also_in",
          "aliases",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "book": {
            "$ref": "#/$defs/book"
          },
          "page": {
            "$ref": "#/$defs/page"
          },
          "also_in": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "uniqueItems": true
          },
          "source": {
            "enum": [
              "pdf",
              "online",
              "manual"
            ]
          },
          "manual_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "site"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "site": {
                  "type": "string"
                },
                "revision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fetched": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "crosscheck": {
            "type": "string",
            "pattern": "^(agree|pdf_only|online_only|resolved:.+)$"
          },
          "desc": {
            "$ref": "#/$defs/desc"
          },
          "id": {
            "type": "string",
            "pattern": "^loresheet:[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "restriction": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "clans_only": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/clan_id"
                }
              }
            ]
          },
          "disciplines_only": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/discipline_id"
                }
              }
            ]
          },
          "thin_blood_only": {
            "type": "boolean"
          },
          "levels": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "dots",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "dots": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 60
                },
                "desc": {
                  "$ref": "#/$defs/desc"
                },
                "restriction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "clans_only": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/clan_id"
                  }
                }
              }
            }
          },
          "clans_excluded": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/clan_id"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "book": {
      "type": "string",
      "pattern": "^v5-[a-z0-9-]+$"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "ref": {
      "type": "object",
      "required": [
        "book",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string",
          "pattern": "^v5-[a-z0-9-]+$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "desc": {
      "type": "object",
      "required": [
        "en",
        "el"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 240
        },
        "el": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "prerequisite": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "power_id"
          ],
          "additionalProperties": false,
          "properties": {
            "power_id": {
              "$ref": "#/$defs/power_id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "additionalProperties": false,
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/power_id"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "additionalProperties": false,
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "power_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "power_id": {
                        "$ref": "#/$defs/power_id"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "any_of"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "any_of": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/power_id"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "power_id": {
      "type": "string",
      "pattern": "^power:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "discipline_id": {
      "type": "string",
      "pattern": "^discipline:[a-z0-9-]+$"
    },
    "clan_id": {
      "type": "string",
      "pattern": "^clan:[a-z0-9-]+$"
    }
  }
}
