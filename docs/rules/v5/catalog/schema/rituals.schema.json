{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadowrealms/v5/catalog/rituals.schema.json",
  "title": "Blood Sorcery rituals",
  "description": "Blood Sorcery rituals by level. koldunic marks Koldunic rituals (Blood Sigils, Tier 2). prerequisite shapes as in disciplines.schema.json (power_id / any_of / all_of).",
  "type": "object",
  "required": [
    "catalog",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "const": "rituals"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "book",
          "page",
          "source",
          "level",
          "also_in",
          "aliases",
          "prerequisite",
          "discipline",
          "koldunic"
        ],
        "additionalProperties": false,
        "properties": {
          "book": {
            "$ref": "#/$defs/book"
          },
          "page": {
            "$ref": "#/$defs/page"
          },
          "also_in": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "uniqueItems": true
          },
          "source": {
            "enum": [
              "pdf",
              "online",
              "manual"
            ]
          },
          "manual_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "site"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "site": {
                  "type": "string"
                },
                "revision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fetched": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "crosscheck": {
            "type": "string",
            "pattern": "^(agree|pdf_only|online_only|resolved:.+)$"
          },
          "desc": {
            "$ref": "#/$defs/desc"
          },
          "id": {
            "type": "string",
            "pattern": "^ritual:[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "level": {
            "$ref": "#/$defs/level"
          },
          "prerequisite": {
            "$ref": "#/$defs/prerequisite"
          },
          "discipline": {
            "$ref": "#/$defs/discipline_id"
          },
          "koldunic": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "book": {
      "type": "string",
      "pattern": "^v5-[a-z0-9-]+$"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "ref": {
      "type": "object",
      "required": [
        "book",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string",
          "pattern": "^v5-[a-z0-9-]+$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "desc": {
      "type": "object",
      "required": [
        "en",
        "el"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 240
        },
        "el": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "prerequisite": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "power_id"
          ],
          "additionalProperties": false,
          "properties": {
            "power_id": {
              "$ref": "#/$defs/power_id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "additionalProperties": false,
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/power_id"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "additionalProperties": false,
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "power_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "power_id": {
                        "$ref": "#/$defs/power_id"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "any_of"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "any_of": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/power_id"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "power_id": {
      "type": "string",
      "pattern": "^power:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "discipline_id": {
      "type": "string",
      "pattern": "^discipline:[a-z0-9-]+$"
    },
    "clan_id": {
      "type": "string",
      "pattern": "^clan:[a-z0-9-]+$"
    }
  }
}
