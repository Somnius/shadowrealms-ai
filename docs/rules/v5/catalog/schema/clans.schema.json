{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadowrealms/v5/catalog/clans.schema.json",
  "title": "V5 clans",
  "description": "13 clans + Caitiff + Thin-blood. Facts only: in-clan Disciplines (ids), where the Bane and Compulsion are printed, Bane name (PG clan sheet), PG bane variants. bane is null when the clan has no bane (Caitiff, Thin-blood); creation holds clan-specific creation rules. desc on the entry, its bane and its compulsion (descriptions/clans.json: '<id>', '<id>:bane', '<id>:compulsion').",
  "type": "object",
  "required": [
    "catalog",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "const": "clans"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "book",
          "page",
          "source",
          "disciplines",
          "bane",
          "compulsion",
          "bane_variants",
          "caitiff",
          "thin_blood"
        ],
        "additionalProperties": false,
        "properties": {
          "book": {
            "$ref": "#/$defs/book"
          },
          "page": {
            "$ref": "#/$defs/page"
          },
          "also_in": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "uniqueItems": true
          },
          "source": {
            "enum": [
              "pdf",
              "online",
              "manual"
            ]
          },
          "manual_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "site"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "site": {
                  "type": "string"
                },
                "revision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fetched": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "crosscheck": {
            "type": "string",
            "pattern": "^(agree|pdf_only|online_only|resolved:.+)$"
          },
          "desc": {
            "$ref": "#/$defs/desc"
          },
          "id": {
            "$ref": "#/$defs/clan_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "disciplines": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/discipline_id"
            }
          },
          "disciplines_page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "bane": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "name",
                  "page"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "name_ref": {
                    "$ref": "#/$defs/ref"
                  },
                  "desc": {
                    "$ref": "#/$defs/desc"
                  }
                }
              }
            ]
          },
          "compulsion": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "name",
                  "book",
                  "page"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "book": {
                    "$ref": "#/$defs/book"
                  },
                  "page": {
                    "$ref": "#/$defs/page"
                  },
                  "desc": {
                    "$ref": "#/$defs/desc"
                  }
                }
              }
            ]
          },
          "bane_variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "book",
                "page"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "book": {
                  "$ref": "#/$defs/book"
                },
                "page": {
                  "$ref": "#/$defs/page"
                },
                "desc": {
                  "$ref": "#/$defs/desc"
                }
              }
            }
          },
          "caitiff": {
            "type": "boolean"
          },
          "thin_blood": {
            "type": "boolean"
          },
          "creation": {
            "type": "object",
            "required": [
              "book",
              "page"
            ],
            "additionalProperties": false,
            "description": "Clan-specific creation rules (Caitiff, core pr 107).",
            "properties": {
              "flaws": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "dots"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^flaw:[a-z0-9-]+$"
                    },
                    "dots": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    }
                  }
                }
              },
              "no_positive_status": {
                "type": "boolean"
              },
              "discipline_xp_multiplier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "book": {
                "$ref": "#/$defs/book"
              },
              "page": {
                "$ref": "#/$defs/page"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "book": {
      "type": "string",
      "pattern": "^v5-[a-z0-9-]+$"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "ref": {
      "type": "object",
      "required": [
        "book",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string",
          "pattern": "^v5-[a-z0-9-]+$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "desc": {
      "type": "object",
      "required": [
        "en",
        "el"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 240
        },
        "el": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "prerequisite": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "power_id"
          ],
          "additionalProperties": false,
          "properties": {
            "power_id": {
              "$ref": "#/$defs/power_id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "additionalProperties": false,
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/power_id"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "additionalProperties": false,
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 2,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "power_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "power_id": {
                        "$ref": "#/$defs/power_id"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "any_of"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "any_of": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/power_id"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "power_id": {
      "type": "string",
      "pattern": "^power:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "discipline_id": {
      "type": "string",
      "pattern": "^discipline:[a-z0-9-]+$"
    },
    "clan_id": {
      "type": "string",
      "pattern": "^clan:[a-z0-9-]+$"
    }
  }
}
