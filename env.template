# ShadowRealms AI - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it's in .gitignore

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Flask application settings
# These variables are used by Docker containers and local development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
# Generate a secure key using: python generate_secret_key.py
# This key is passed to Docker containers via docker-compose.yml
FLASK_SECRET_KEY=your-super-secret-key-here-change-this
VERSION=0.8.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite database path (legacy - for rollback only)
DATABASE=/app/data/shadowrealms.db

# PostgreSQL Configuration (primary database)
# ⚠️  SECURITY CRITICAL: Generate unique credentials for YOUR installation!
# See docs/POSTGRESQL_ENV_SETUP.md for secure credential generation
# DO NOT use these placeholder values in production!
POSTGRES_DB=shadowrealms_db
POSTGRES_USER=GENERATE_UNIQUE_USERNAME
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD
DATABASE_TYPE=postgresql
DATABASE_HOST=postgresql
DATABASE_PORT=5432

# =============================================================================
# AI/LLM INTEGRATION
# =============================================================================
# Legacy, not used by the AI providers. Cloud keys (Anthropic, OpenAI) and the Typesafe Jev key are
# entered by an admin in Admin -> Ai System and stored encrypted (key derived from FLASK_SECRET_KEY;
# changing FLASK_SECRET_KEY makes them unreadable, re-enter them then). See docs/AI_SYSTEMS.md.
OPENAI_API_KEY=your-openai-api-key-here

# Local LLM configuration
LLM_HOST=localhost
LLM_PORT=11434
LLM_MODEL=gemma-4-e2b-it
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# =============================================================================
# CHROMADB VECTOR DATABASE
# =============================================================================
# ChromaDB connection settings
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION=shadowrealms_memory

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password-here

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# JWT token settings
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# =============================================================================
# GPU MONITORING
# =============================================================================
# GPU performance thresholds (percentages)
GPU_THRESHOLD_HIGH=80
GPU_THRESHOLD_MEDIUM=60

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================
# LM Studio configuration
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_API_KEY=
# auto (or empty) = use first model id from GET /v1/models — matches whatever LM Studio lists (usually loaded stack)
LM_STUDIO_MODEL=auto
LM_STUDIO_TIMEOUT=30
# Reasoning models (e.g. Gemma 4, Qwen3.5) think before answering. "none" turns that off
# (Qwen3.5 without it spends the whole token budget thinking and returns an empty reply)
# (faster, and short replies like /ai ping are not eaten by thinking). Empty = model default.
LM_STUDIO_REASONING_EFFORT=none

# Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=command-r:35b
OLLAMA_TIMEOUT=30

# --- v0.9 AI roles, embeddings, classifier (docs/AI_SYSTEMS.md) ---
# Default model of the Greek Storyteller role (players writing Greek). Krikri writes clean Greek;
# the English role follows LM_STUDIO_MODEL / the loaded model. Both are changeable in Admin -> Ai System.
STORYTELLER_EL_MODEL=llama-krikri-8b-instruct
# Utility role (quick dice/combat answers when no role is given)
UTILITY_PROVIDER=ollama
UTILITY_MODEL=llama3.2:3b
# LM Studio embedding model for every ChromaDB collection (RAG). bge-m3 handles English + Greek.
# Changing it re-embeds the collections at the next backend start (or Admin -> Ai System -> Re-embed,
# or: docker compose exec backend python reembed_rag.py).
EMBEDDING_MODEL=text-embedding-bge-m3
# OOC monitor: P(in character) at which a message in an OOC room counts as a violation (3 = 24 h ban
# from that campaign). Only meaningful for Laya/Jev; the LLM fallback answers YES/NO (1.0/0.0).
OOC_VIOLATION_THRESHOLD=0.8
# Sent to OpenAI chat completions for reasoning models (gpt-5*, o-series) when an admin enables OpenAI
# ("none" = no hidden reasoning). Other models never get it; a 400 about it is retried once without it.
OPENAI_REASONING_EFFORT=none
# Storyteller replies: seconds per model attempt, and for the whole fallback chain (nginx gives /api 60 s)
STORYTELLER_ATTEMPT_TIMEOUT=45
STORYTELLER_TIME_BUDGET=55
# Context window the Storyteller prompt is trimmed to fit (lowered to LM Studio's loaded context if smaller)
STORYTELLER_CONTEXT_TOKENS=8192
# Typesafe Jev model (optional classifier; key is set in the admin panel)
JEV_MODEL=jev-latest
# Optional: where the Laya classifier lives (default backend/data/laya/model = repo data/laya/model in Docker)
# LAYA_MODEL_DIR=/app/data/laya/model
# LAYA_RUNTIME=/app/data/laya/model/infer.py

# AI response configuration
AI_MAX_TOKENS_FAST=256
AI_MAX_TOKENS_MEDIUM=512
AI_MAX_TOKENS_SLOW=1024
AI_TEMPERATURE_FAST=0.6
AI_TEMPERATURE_MEDIUM=0.7
AI_TEMPERATURE_SLOW=0.8

# =============================================================================
# LOGGING
# =============================================================================
# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/backend.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# EMAIL / SMTP (optional — registration welcome + invalid-invite admin alerts)
# =============================================================================
# Leave SMTP_HOST empty to disable outbound email (API still works; emails are skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on port 587 (typical). Set SMTP_USE_SSL=true for SMTPS on 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Display name in welcome emails
APP_PUBLIC_NAME=ShadowRealms AI
# If set and SMTP is configured, invalid signup attempts trigger an email to this address.
MAIL_ADMIN_ALERT_EMAIL=

# =============================================================================
# SECURITY
# =============================================================================
# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# RPG SYSTEM CONFIGURATION
# =============================================================================
# Default RPG system (D&D 5e, Pathfinder, etc.)
DEFAULT_RPG_SYSTEM=D&D 5e

# =============================================================================
# TRANSLATION PIPELINE
# =============================================================================
# Greek translation service settings
GREEK_TRANSLATION_ENABLED=true
GREEK_MODEL_HOST=localhost
GREEK_MODEL_PORT=11435

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION_LEVEL=9
BACKUP_EXCLUDE_PATTERNS=*.tmp,*.log,node_modules/

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development-specific settings
DEVELOPMENT_MODE=false
TESTING_MODE=false
MOCK_AI_RESPONSES=false
