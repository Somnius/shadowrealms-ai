# ShadowRealms AI - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it's in .gitignore
#
# How .env is used: docker compose reads it and passes the variables listed under the backend's
# `environment:` in docker-compose.yml into the container. A variable that is not listed there
# never reaches the backend, whatever you put here. Every variable is described in
# docs/DOCKER_ENV_SETUP.md ("Environment variables").

# =============================================================================
# APPLICATION
# =============================================================================
# Generate secure keys with: python3 scripts/generate_secret_key.py
# FLASK_SECRET_KEY also derives the key that encrypts the AI provider keys stored in the
# database; changing it makes them unreadable (re-enter them in Admin -> Ai System).
FLASK_SECRET_KEY=your-super-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
# Speech service (docs/VOICE.md): shared secret between backend and speech, e.g. openssl rand -hex 32
SPEECH_SECRET=
# Cloud voices (docs/VOICE.md, 0.23): Google Gemini TTS keys for the speech service, turned on in
# Admin -> AI system. Free tier: Google may use the text to improve its products. Paid tier
# (billing on the key's Google project): it does not, and the use is billed. Leave empty for off.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
# Transcript check after voice transcription (docs/VOICE.md, 0.21): 0 turns it off; Krikri model in LM Studio
VOICE_TRANSCRIPT_CHECK=1
TRANSCRIPT_CHECK_MODEL=llama-krikri-8b-instruct
# Disk caps: spoken-line cache (speech) and stored recordings (backend), in GB
VOICE_TTS_CACHE_GB=5
VOICE_CLIPS_MAX_GB=20
# Release version (shown by /api/version); bumped by scripts/version-bump.sh
VERSION=0.29.0

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# ⚠️  SECURITY CRITICAL: Generate unique credentials for YOUR installation!
# See docs/POSTGRESQL_ENV_SETUP.md for secure credential generation
# DO NOT use these placeholder values in production!
POSTGRES_DB=shadowrealms_db
POSTGRES_USER=GENERATE_UNIQUE_USERNAME
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD
DATABASE_TYPE=postgresql
# localhost, not the compose service name: the backend uses the host network
DATABASE_HOST=localhost
DATABASE_PORT=5432

# =============================================================================
# SECURITY (docs/SECURITY_MODEL.md)
# =============================================================================
# The browser talks to the backend through nginx on the same origin, so no CORS is needed.
# Leave empty. Only list extra origins (comma-separated, no "*") if another site must call the API.
CORS_ORIGINS=

# Optional; docker-compose.yml supplies the defaults shown. Uncomment to change.
# Backend server: gunicorn (production) or flask (dev server with auto-reload; also set
# FLASK_ENV=development)
# APP_SERVER=gunicorn
# FLASK_ENV=production
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=48
# GUNICORN_BIND=127.0.0.1:5000
# Session lifetimes: access token (minutes), refresh cookie (days), hard cap on a session (days)
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=14
# JWT_SESSION_MAX_DAYS=30
# BCRYPT_ROUNDS=12
# PASSWORD_MIN_LENGTH=12
# Proxies in front of the backend whose X-Forwarded-For is trusted (1 = the local nginx)
# TRUSTED_PROXY_HOPS=1
# RATELIMIT_ENABLED=true
# Live updates (Server-Sent Events): open streams per gunicorn worker, and per user per worker
# SR_EVENTS_MAX_STREAMS=20
# SR_EVENTS_MAX_STREAMS_PER_USER=4

# =============================================================================
# AI / LLM (docs/AI_SYSTEMS.md)
# =============================================================================
# Cloud keys (Anthropic, OpenAI) and the Typesafe Jev key are not set here: an admin enters them
# in Admin -> Ai System and they are stored encrypted.

# LM Studio (runs on the host, http://localhost:1234)
LM_STUDIO_API_KEY=
# auto (or empty) = use first model id from GET /v1/models — matches whatever LM Studio lists (usually loaded stack)
LM_STUDIO_MODEL=auto
LM_STUDIO_TIMEOUT=30
# Reasoning models (e.g. Gemma 4, Qwen3.5) think before answering. "none" turns that off
# (Qwen3.5 without it spends the whole token budget thinking and returns an empty reply)
# (faster, and short replies like /ai ping are not eaten by thinking). Empty = model default.
LM_STUDIO_REASONING_EFFORT=none

# Ollama (runs on the host, http://localhost:11434)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

# Default model of the Greek Storyteller role (players writing Greek). Krikri writes clean Greek;
# the English role follows LM_STUDIO_MODEL / the loaded model. Both are changeable in Admin -> Ai System.
STORYTELLER_EL_MODEL=llama-krikri-8b-instruct
# "The chronicle so far" (docs/CHRONICLE.md): the writer's default models per chronicle language
# (Admin -> Ai System changes them), how long a chronicle must be quiet before the writer starts,
# how long to wait after "Context size has been exceeded" before splitting the night, and an
# optional cap on the context it plans for (empty = the loaded LM Studio model's context).
CHRONICLER_EL_MODEL=llama-krikri-8b-instruct
CHRONICLER_EN_MODEL=
CHRONICLE_QUIET_MINUTES=10
CHRONICLE_OVERFLOW_WAIT_S=30
CHRONICLE_CONTEXT_TOKENS=
# Caps per writer job: nights, seconds of writing (it stops after the night that passes it), and
# how many days finished job rows are kept. The nightly run (per chronicle, off by default) starts
# at CHRONICLE_NIGHTLY_AT in CHRONICLE_NIGHTLY_TZ (05:00 Europe/Athens) and queues chronicles for up
# to 3 hours after it. Don't set TZ on the backend container for this: message times are stored and
# shown as UTC; only the nightly hour and the writer-health "today" use CHRONICLE_NIGHTLY_TZ.
CHRONICLE_MAX_NIGHTS_PER_JOB=40
CHRONICLE_MAX_SECONDS_PER_JOB=3600
CHRONICLE_JOB_KEEP_DAYS=90
CHRONICLE_NIGHTLY_AT=05:00
CHRONICLE_NIGHTLY_TZ=Europe/Athens
# Utility role (quick dice/combat answers when no role is given)
UTILITY_PROVIDER=ollama
UTILITY_MODEL=llama3.2:3b
# LM Studio embedding model for every ChromaDB collection (RAG). bge-m3 handles English + Greek.
# Changing it re-embeds the collections at the next backend start (or Admin -> Ai System -> Re-embed,
# or: docker compose exec backend python reembed_rag.py).
EMBEDDING_MODEL=text-embedding-bge-m3
# OOC monitor: P(in character) at which a message in an OOC room counts as a violation (3 = 24 h ban
# from that campaign). Only meaningful for Laya/Jev; the LLM fallback answers YES/NO (1.0/0.0).
OOC_VIOLATION_THRESHOLD=0.8
# Sent to OpenAI chat completions for reasoning models (gpt-5*, o-series) when an admin enables OpenAI
# ("none" = no hidden reasoning). Other models never get it; a 400 about it is retried once without it.
OPENAI_REASONING_EFFORT=none
# Storyteller replies: seconds per model attempt, and for the whole fallback chain (nginx gives /api 60 s)
STORYTELLER_ATTEMPT_TIMEOUT=45
STORYTELLER_TIME_BUDGET=55
# Context window the Storyteller prompt is trimmed to fit (lowered to LM Studio's loaded context if smaller)
STORYTELLER_CONTEXT_TOKENS=8192
# Typesafe Jev model (optional classifier; key is set in the admin panel)
JEV_MODEL=jev-latest

# =============================================================================
# EMAIL / SMTP (optional — registration welcome + invalid-invite admin alerts)
# =============================================================================
# Leave SMTP_HOST empty to disable outbound email (API still works; emails are skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on port 587 (typical). Set SMTP_USE_SSL=true for SMTPS on 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Display name in welcome emails
APP_PUBLIC_NAME=ShadowRealms AI
# If set and SMTP is configured, invalid signup attempts trigger an email to this address.
MAIL_ADMIN_ALERT_EMAIL=

# =============================================================================
# FIXED IN docker-compose.yml
# =============================================================================
# The backend container gets these values from docker-compose.yml directly, so changing them
# here does not change the running app (edit docker-compose.yml instead). They stay here for
# scripts that read .env on the host and for reference.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
LM_STUDIO_URL=http://localhost:1234
OLLAMA_URL=http://localhost:11434
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
REDIS_HOST=redis
REDIS_PORT=6379
GPU_THRESHOLD_HIGH=80
GPU_THRESHOLD_MEDIUM=60
LOG_LEVEL=INFO
LOG_FILE=/app/logs/backend.log
# The Laya classifier runtime is set in docker-compose.yml (LAYA_RUNTIME=/app/ml/laya/infer.py);
# the model is read from data/laya/model. LAYA_MODEL_DIR is not passed to the container.
# LAYA_MODEL_DIR=/app/data/laya/model
